[Unit]
Description=Annual Filings Chatbot API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/projects/retail-intelligence-ai
EnvironmentFile=/home/ubuntu/projects/retail-intelligence-ai/.env
Environment=PYTHONPATH=/home/ubuntu/projects/retail-intelligence-ai
Environment=RAG_RETRIEVAL_POLICY=balanced_anchored_round_robin_k16
Environment=RAG_ANCHORED_CONFIG=/home/ubuntu/projects/retail-intelligence-ai/config/retrieval_anchored_k16_gpu_v1.json
Environment=RAG_MODEL_DEVICE=cpu
Environment=RAG_RERANKER_BACKEND=remote
Environment=BEDROCK_REGION=eu-north-1
Environment=BEDROCK_MODEL_ID=deepseek.v3.2
Environment=CHATBOT_ENV=staging
Environment=CHATBOT_MAX_CONCURRENT_REQUESTS=1
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
ExecStart=/home/ubuntu/projects/retail-intelligence-ai/venv/bin/python -m uvicorn app.api.main:app --host 127.0.0.1 --port 8000 --workers 1 --timeout-keep-alive 5
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
